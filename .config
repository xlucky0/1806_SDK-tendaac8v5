CONFIG_TARGET_siflower=y
CONFIG_TARGET_siflower_sf19a2890=y
CONFIG_TARGET_siflower_sf19a2890_DEVICE_tenda_ac8-v5=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_siflower_sf19a2890_DEVICE_tenda_ac8-v5=y
CONFIG_TARGET_DEVICE_PACKAGES_siflower_sf19a2890_DEVICE_tenda_ac8-v5=""

# Driver Hardware Utama
CONFIG_PACKAGE_kmod-siflower-wifi=y
CONFIG_PACKAGE_kmod-mt7530u=y

# Antarmuka Web (LuCI)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# Protokol Jaringan & PPPoE
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y

# Penghematan Ruang Penyimpanan (Tanpa Fitur USB)
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb2 is not set
  
