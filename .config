CONFIG_TARGET_siflower=y
CONFIG_TARGET_siflower_sf19a28=y
CONFIG_TARGET_siflower_sf19a28_Tenda_AC8v5=y
CONFIG_DEVEL=y

# --- LuCI Ringan (Minimalis untuk hemat space) ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# --- Driver Wi-Fi & Jaringan Esensial ---
CONFIG_PACKAGE_wireless-tools=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_kmod-ipt-extra=y
CONFIG_PACKAGE_iptables-mod-extra=y

# --- Optimasi Ukuran (Hapus modul tidak penting) ---
CONFIG_ALL_KMODS=n
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_opkg=y
